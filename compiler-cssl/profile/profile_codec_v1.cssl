pub fn profile_id_byte_v1(
    index: i64,
    csl: u32, nil: u32, cssl: u32, codec: u32, abi: u32,
    numeric: u32, rng: u32, normalization: u32,
    endianness: u32, versions: u32
) -> i64 {
    if index < 0i64 { return 0i64 - 1i64; }
    if index >= 32i64 { return 0i64 - 1i64; }
    let word_index = index / 4i64;
    let byte_index = (index % 4i64) as u32;
    let shift = (3u32 - byte_index) * 8u32;
    let word = profile_id_word_v1(
        word_index, csl, nil, cssl, codec, abi, numeric, rng,
        normalization, endianness, versions
    );
    ((word >> shift) & 255u32) as i64
}

pub fn profile_digest_length_status_v1(count: i64) -> i32 {
    if count != 32i64 { return 2001i32; }
    0i32
}

pub fn profile_bytes_status_v1(
    src: &[u8; 48], count: i64,
    csl: u32, nil: u32, cssl: u32, codec: u32, abi: u32,
    numeric: u32, rng: u32, normalization: u32,
    endianness: u32, versions: u32
) -> i32 {
    let structural = profile_validate_v1(
        csl, nil, cssl, codec, abi, numeric, rng, normalization,
        endianness, versions
    );
    if structural != 0i32 { return structural; }
    if count != 48i64 { return 2002i32; }
    let mut index: i64 = 0i64;
    while index < 48i64 {
        let expected = profile_canonical_byte_v1(
            index, csl, nil, cssl, codec, abi, numeric, rng,
            normalization, endianness, versions
        );
        if (src[index] as u32) != expected { return 2003i32; }
        index = index + 1;
    }
    0i32
}

pub fn profile_resume_status_v1(
    saved: &[u8; 32], count: i64,
    csl: u32, nil: u32, cssl: u32, codec: u32, abi: u32,
    numeric: u32, rng: u32, normalization: u32,
    endianness: u32, versions: u32
) -> i32 {
    if count != 32i64 { return 2001i32; }
    let mut index: i64 = 0i64;
    while index < 32i64 {
        let expected = profile_id_byte_v1(
            index, csl, nil, cssl, codec, abi, numeric, rng,
            normalization, endianness, versions
        );
        if (saved[index] as i64) != expected { return 3002i32; }
        index = index + 1;
    }
    let structural = profile_validate_v1(
        csl, nil, cssl, codec, abi, numeric, rng, normalization,
        endianness, versions
    );
    if structural != 0i32 { return structural; }
    0i32
}

pub fn u128_add_lo_v1(left_lo: u64, right_lo: u64) -> u64 {
    left_lo + right_lo
}

pub fn u128_add_hi_v1(
    left_lo: u64, left_hi: u64, right_lo: u64, right_hi: u64
) -> u64 {
    let low = left_lo + right_lo;
    let mut carry: u64 = 0u64;
    let low_carry_bits = (left_lo & right_lo) | ((left_lo | right_lo) & (!low));
    if (low_carry_bits as i64) < 0i64 { carry = 1u64; }
    left_hi + right_hi + carry
}

pub fn u128_add_status_v1(
    left_lo: u64, left_hi: u64, right_lo: u64, right_hi: u64
) -> i32 {
    let low = left_lo + right_lo;
    let mut carry: u64 = 0u64;
    let low_carry_bits = (left_lo & right_lo) | ((left_lo | right_lo) & (!low));
    if (low_carry_bits as i64) < 0i64 { carry = 1u64; }
    let high_base = left_hi + right_hi;
    let high_base_carry_bits = (left_hi & right_hi) | ((left_hi | right_hi) & (!high_base));
    if (high_base_carry_bits as i64) < 0i64 { return 4001i32; }
    let high = high_base + carry;
    let high_carry_bits = (high_base & carry) | ((high_base | carry) & (!high));
    if (high_carry_bits as i64) < 0i64 { return 4001i32; }
    0i32
}

pub fn u128_le_byte_v1(lo: u64, hi: u64, index: i64) -> i64 {
    if index < 0i64 { return 0i64 - 1i64; }
    if index >= 16i64 { return 0i64 - 1i64; }
    if index < 8i64 {
        let shift = (index as u64) * 8u64;
        return ((lo >> shift) & 255u64) as i64;
    }
    let shift = ((index - 8i64) as u64) * 8u64;
    ((hi >> shift) & 255u64) as i64
}

// Inline two-u64 composite semantics are distinct from native scalar u128 and
// from the pinned compiler's cross-function u64-call defect.
pub fn u128_composite_status_v1() -> i32 {
    let left_lo: u64 = 0xffffffffffffffffu64;
    let right_lo: u64 = 1u64;
    let low = left_lo + right_lo;
    if low != 0u64 { return 9013i32; }
    let high = 0u64 + 0u64 + 1u64;
    if high != 1u64 { return 9013i32; }
    0i32
}

// Separate typed defect: compiler-generated cross-function u64 argument calls
// disagree with the same exported helpers exercised through the C ABI.
pub fn u64_cross_call_status_v1() -> i32 {
    if u128_add_lo_v1(0xffffffffffffffffu64, 1u64) != 0u64 { return 9005i32; }
    if u128_add_hi_v1(0xffffffffffffffffu64, 0u64, 1u64, 0u64) != 1u64 { return 9005i32; }
    0i32
}
