module apocrypha.v2.profile.profile_codec_v1

extern "C" fn profile_validate_v1(
    csl: u32, nil: u32, cssl: u32, codec: u32, abi: u32,
    numeric: u32, rng: u32, normalization: u32,
    endianness: u32, versions: u32
) -> i32;

// § Fixed 48-byte profile codec + one-block SHA-256 + numeric sentinels.
// No allocation, mutable external storage, effects, persistence, or RNG draw.

fn sha_rotr2(x: u32) -> u32 { ((x >> 2u32) & 0x3fffffffu32) | (x << 30u32) }
fn sha_rotr6(x: u32) -> u32 { ((x >> 6u32) & 0x03ffffffu32) | (x << 26u32) }
fn sha_rotr7(x: u32) -> u32 { ((x >> 7u32) & 0x01ffffffu32) | (x << 25u32) }
fn sha_rotr11(x: u32) -> u32 { ((x >> 11u32) & 0x001fffffu32) | (x << 21u32) }
fn sha_rotr13(x: u32) -> u32 { ((x >> 13u32) & 0x0007ffffu32) | (x << 19u32) }
fn sha_rotr17(x: u32) -> u32 { ((x >> 17u32) & 0x00007fffu32) | (x << 15u32) }
fn sha_rotr18(x: u32) -> u32 { ((x >> 18u32) & 0x00003fffu32) | (x << 14u32) }
fn sha_rotr19(x: u32) -> u32 { ((x >> 19u32) & 0x00001fffu32) | (x << 13u32) }
fn sha_rotr22(x: u32) -> u32 { ((x >> 22u32) & 0x000003ffu32) | (x << 10u32) }
fn sha_rotr25(x: u32) -> u32 { ((x >> 25u32) & 0x0000007fu32) | (x << 7u32) }

fn sha_small0(x: u32) -> u32 {
    sha_rotr7(x) ^ sha_rotr18(x) ^ ((x >> 3u32) & 0x1fffffffu32)
}

fn sha_small1(x: u32) -> u32 {
    sha_rotr17(x) ^ sha_rotr19(x) ^ ((x >> 10u32) & 0x003fffffu32)
}

fn sha_big0(x: u32) -> u32 {
    sha_rotr2(x) ^ sha_rotr13(x) ^ sha_rotr22(x)
}

fn sha_big1(x: u32) -> u32 {
    sha_rotr6(x) ^ sha_rotr11(x) ^ sha_rotr25(x)
}

fn sha_choose(x: u32, y: u32, z: u32) -> u32 {
    (x & y) ^ ((!x) & z)
}

fn sha_majority(x: u32, y: u32, z: u32) -> u32 {
    (x & y) ^ (x & z) ^ (y & z)
}

fn sha_bswap32(x: u32) -> u32 {
    ((x & 0x000000ffu32) << 24u32)
    | ((x & 0x0000ff00u32) << 8u32)
    | (((x & 0x00ff0000u32) >> 8u32) & 0x0000ff00u32)
    | (((x & 0xff000000u32) >> 24u32) & 0x000000ffu32)
}

pub fn profile_canonical_byte_v1(
    index: i64,
    csl: u32, nil: u32, cssl: u32, codec: u32, abi: u32,
    numeric: u32, rng: u32, normalization: u32,
    endianness: u32, versions: u32
) -> u32 {
    if index < 0i64 { return 0xffffffffu32; }
    if index >= 48i64 { return 0xffffffffu32; }
    if index == 0i64 { return 0x41u32; }
    if index == 1i64 { return 0x50u32; }
    if index == 2i64 { return 0x58u32; }
    if index == 3i64 { return 0x4cu32; }
    if index == 4i64 { return 0x50u32; }
    if index == 5i64 { return 0x52u32; }
    if index == 6i64 { return 0x46u32; }
    if index == 7i64 { return 0x31u32; }
    let field_index = (index - 8i64) / 4i64;
    let shift = (((index - 8i64) % 4i64) * 8i64) as u32;
    let mut field: u32 = csl;
    if field_index == 1i64 { field = nil; }
    if field_index == 2i64 { field = cssl; }
    if field_index == 3i64 { field = codec; }
    if field_index == 4i64 { field = abi; }
    if field_index == 5i64 { field = numeric; }
    if field_index == 6i64 { field = rng; }
    if field_index == 7i64 { field = normalization; }
    if field_index == 8i64 { field = endianness; }
    if field_index == 9i64 { field = versions; }
    let shifted = field >> shift;
    shifted & 255u32
}

