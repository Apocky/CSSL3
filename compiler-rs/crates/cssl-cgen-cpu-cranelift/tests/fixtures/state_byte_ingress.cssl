// § N2 bounded byte transport oracle; no codec/identity/admission claim.
// W! caller supplies live borrowed65536bytes; count0..65536; writes.NONE.
pub fn state_byte_sum(src : &[u8; 65536], count : i64) -> i64 {
    if count < 0 { return 0 - 1; }
    if count > 65536 { return 0 - 1; }
    let mut index : i64 = 0;
    let mut total : i64 = 0;
    while index < count {
        let byte = src[index] as i64;
        total = total + byte;
        index = index + 1;
    }
    return total;
}
pub fn state_byte_weighted_sum(src : &[u8; 65536], count : i64) -> i64 {
    if count < 0 { return 0 - 1; }
    if count > 65536 { return 0 - 1; }
    let mut index : i64 = 0;
    let mut total : i64 = 0;
    while index < count {
        let byte = src[index] as i64;
        total = total + byte * (index + 1);
        index = index + 1;
    }
    return total;
}
