    change:
      shader now derives 2D camera ray:
        x_norm = clamp(gid.x / max(observer.width-1,1),0,1)
        y_norm = clamp(gid.y / max(observer.height-1,1),0,1)
        dx_raw = ((x_norm - 0.5) * 0.5) + yaw_offset
        dy_raw = (0.5 - y_norm) * 0.5
        ray = normalize(⟨dx_raw,dy_raw,1⟩)
      output encoding:
        red   = v13 shaded camera ray + crystal emissive
        green = x_norm
        blue  = descriptor canary
        alpha = y_norm
