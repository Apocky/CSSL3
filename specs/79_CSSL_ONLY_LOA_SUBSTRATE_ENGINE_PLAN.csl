  p1.camera_tile_2d:
    status: ✓ implemented
    discipline:
      `gid.y` and observer.height must be validated through readback, not assumed
      full 8×8 local workgroup footprint must be copied and compared
      output channels should expose both camera axes during maturation
    files:
      C:\Users\Apocky\source\repos\CSSLv3\compiler-rs\crates\cssl-cgen-gpu-spirv\src\substrate_kernel.rs
