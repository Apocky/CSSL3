  p1.crystal_spatial_influence:
    status: ✓ implemented
    discipline:
      crystal storage must carry spatial data, not only scalar strength
      spatial decode must be represented in CPU oracle and GPU SPIR-V
      present path must pack host crystal position into the same byte-scale contract
    files:
      C:\Users\Apocky\source\repos\CSSLv3\compiler-rs\crates\cssl-cgen-gpu-spirv\src\substrate_kernel.rs
