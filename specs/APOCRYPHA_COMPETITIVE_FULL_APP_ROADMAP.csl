═══════════════════════════════════════════════════════════════════════════════
§ “BETTER” — PRE-REGISTERED MATCHED BENCHMARKS
═══════════════════════════════════════════════════════════════════════════════

B1 proof_completion := {
  metrics: [verified_success_rate, false_done_rate, named_oracle_coverage, verifier_independence],
  targets: [false_done_rate<1%, named_oracle_coverage=100%]
}
B2 interruption_continuity := {
  chaos: [process-kill, model-swap, compaction, network-loss, duplicate-delivery],
  metrics: [resume_to_success@1, invariant_retention, duplicate_effects, omitted_effects, recovery_time],
  targets: [resume_to_success>=99%, duplicate_effects=0, omitted_effects=0, live-state-rollback=0]
}
B3 authority_reversibility := {
  metrics: [unauthorized_effect_rate, revoked_lease_enforcement, preimage_coverage, rollback_success, rollback_time],
  targets: [unauthorized_effect_rate=0, irreversible_consent=100%, rollback_success>=99%]
}
B4 portable_memory := {
  metrics: [provenance_coverage, recall_precision, stale_action_rate, correction_delete_propagation, export_import_fidelity],
  targets: [provenance_coverage=100%, recall_precision>=95%, verified_delete=100%]
}
B5 verified_success_router := {
  metrics: [success_per_dollar, p95_time_to_verified_success, failover_success, provider_switch_quality_loss],
  targets: [models>=5, pareto_gain>=20%, state_loss_on_failover=0]
}

strongest_countercase := frontier vendors already ship steering, memory, outcome graders, verification workflows,
                         hosted computers, and managed agents.
falsifier := matched benchmark shows Apocrypha no better on cross-provider enforcement/live-oracle outcomes.
response := retain parity capability; remove superiority wording; fix measured bottleneck; rerun all arms.

