I> scope := CSSL3 local concrete-type gate for csslc.check+build main+all aux modules.

§P observed.defect
  ✓ `cssl_hir::check_module` existed but csslc.check+build stopped after HIR lowering.
  ✓ parseable type-invalid programs reached build lowering/artifact paths.
  ✓ audit counterexamples included `~bool`, integer literal|u8 return→bool,
    `u8 as bool`, and concrete invalid `!` domains.
  W! legacy CSSL integer `!` = bitwise complement ; N! silently change accepted code.

§D admitted.delta
  check := lex→parse→HIR-lower→HIR-check→typed diagnostic→success|USER_ERROR.
  build.main := same gate before aux+MIR+artifact emission.
  build.aux := ∀ `--module-path`, independent lower+check gate before MIR+artifact emission.
  diagnostic := real source line+column + stable `[TYPECHECK]` class + actionable message.
  unary := {
    `!bool`→bool.logical-not,
    `!integer`→integer.bitwise-complement,
    `~integer`→integer.bitwise-complement,
    `~bool`|`!float`|`!String`→fatal.type-error
  }.
  bool.ingress.local := {
    literal.integer→bool.return=reject,
    u8→bool.return=reject,
    u8-as-bool=reject+explicit-comparison guidance
  }.
  compatibility := {
    i128|u128 primitive recognition,
    Vec nominal+Vec.new,
    quantum intrinsics+panic,
    local generic nominal arity,
    external|prelude opacity boundaries below
  }.

