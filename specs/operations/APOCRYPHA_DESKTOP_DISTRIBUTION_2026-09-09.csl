§S OPEN
  Authenticode.cert → removes SmartScreen ; ~$300/yr ; Apocky.purchase.decision
  macOS := blocked ← ¬ Mac ∧ ¬ xcodebuild|codesign on this host
  Linux := AppImage possible via WSL2|CI ; ¬ attempted this slice
  auto-update := absent by design ; person returns to /download/apocrypha
  production.deploy := Apocky's act ← vercel --prod from cssl-edge ; N! agent.deploy w/o consent

§C ROLLBACK
  site := revert the commit → manifest absent → loadDesktopRelease → preparing → card reads "not available yet"
          ; phone entries untouched throughout
  client := installed copy is per-user ; Settings → Apps → Installed apps ; sign-out clears the encrypted store
  artifact := delete public/downloads/Apocrypha-Desktop-*.exe{,.sha256}

