{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apocrypha Desktop",
  "version": "0.1.0",
  "identifier": "com.apocky.apocrypha.desktop",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "beforeDevCommand": "npm --prefix frontend run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Apocrypha",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": [{
        "identifier": "local-workbench",
        "description": "Local task IPC and native events for the bundled workbench only.",
        "local": true,
        "windows": ["main"],
        "permissions": [
          "allow-local-bootstrap", "allow-local-new-session", "allow-local-open-session",
          "allow-local-send", "allow-local-cancel", "allow-local-consent", "allow-local-request",
          "core:event:allow-listen", "core:event:allow-unlisten"
        ]
      }]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Apocrypha local coding workbench",
    "longDescription": "Work with the local Apocrypha host: submit coding tasks, inspect real file and command results, review approvals, and resume saved history without website sign-in.",
    "publisher": "Apocky",
    "copyright": "© Apocky",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
