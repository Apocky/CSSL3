{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apocrypha Desktop",
  "version": "0.1.0",
  "identifier": "com.apocky.apocrypha.desktop",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Apocrypha",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Apocrypha · account client for apocky.com",
    "longDescription": "Sign in with your Apocky account and talk to Apocrypha. Conversations are held by the service and stay private to your account.",
    "publisher": "Apocky",
    "copyright": "© Apocky",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
