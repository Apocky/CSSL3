§ APOCRYPHA.CONTRIBUTOR.RELEASE.ARTIFACT.PIPELINE.v1 ‼

purpose := deterministic candidate artifact + evidence bundle
scope := source/build/promotion tooling ; N! publisher key custody ; N! live cutover
reuse := contributor-node/package.json pack:candidate
         + lib/apocrypha/contributor-node.ts fail-closed release vocabulary

§D INPUT
  root := cssl-edge/contributor-node
  files := {
    README.md, RELEASE.csl, package.json,
    dist/cli.js, dist/cli.d.ts, dist/runtime.js, dist/runtime.d.ts
  }
  order := UTF-8 path lexicographic
  missing|duplicate|path.escape := reject
  source_date_epoch := explicit integer ∈ [0, 2^53-1] ; default=0 only for local candidate
  source_commit := explicit OR git HEAD ; absent ⇒ provenance.gate=false

§D ARCHIVE
  command := npm run pack:candidate ⊕ release-artifacts.mjs
  format := ZIP32 stored entries ; no compression
  metadata := fixed DOS date=1980-01-01 ; fixed time=00:00:00 ; fixed flags/attrs
  archive := apocrypha-contributor-node-{version}.zip
  digest := SHA256(exact.archive.bytes)
  N! candidate npm.tgz ⇒ public release artifact

§D EVIDENCE
  sbom := SPDX-2.3 ; one package + one file record per archive entry ; SHA256 each
  provenance := in-toto Statement v1 / SLSA provenance shape
               ; source repo+commit+source_date_epoch+archive+SBOM subjects
  promotion := apocrypha.contributor.release.v1
              ; archive/SBOM/provenance metadata + gate vector + missing_gates
  canonical_json := recursive object-key sort ; array order preserved ; finite numbers only
  generated bytes := canonical UTF-8 JSON ; no wall-clock or host-path fields

§D SIGNATURE
  scope := exact archive bytes only
  algorithm := Ed25519 ; detached signature := unpadded base64url(64 bytes)
  verifier := scripts/verify-detached-signature.mjs
  verifier.input := artifact bytes + detached signature + PEM public key + optional expected SHA256
  verifier.output := typed {ok,algorithm,artifact_sha256} OR {ok=false,code,artifact_sha256}
  N! verifier accepts private key | signs | fetches | mutates release state

§D PROMOTION
  gates := {
    deterministic_archive, sbom, provenance, artifact_sha256,
    detached_signature, pinned_signer, controller_transport,
    authenticated_contribution_oracle, native_install_smoke,
    sandbox_enforced, malware_scan, rollback_proof, mobile_artifacts
  }
  candidate.default := all gates false except deterministic_archive+sbom+artifact_sha256
  release.default := NOT_DEPLOYABLE ∧ release_gate=CLOSED ∧ production_eligible=false
  evaluate := fail-closed if any gate=false OR artifact/signature/key/input absent
  READY ∧ OPEN ⇒ every gate=true ∧ digest match ∧ detached Ed25519 verify
  forged state/gates N! promote without verifier inputs

§T TESTS
  deterministic := entry order+ZIP metadata+bytes stable across runs
  evidence := SBOM/provenance/promotion bytes stable for fixed input+epoch+commit
  signature := valid test key ✓ ; tamper/hash/missing/public-key failures ✓
  promotion := forged READY/OPEN rejected ✓ ; missing gate list typed ✓
  command := node tests/contributor-node/release-pipeline.test.mjs

§C OPEN
  signed publisher artifact+key custody ; controller transport ; authenticated contribution receipt
  native installer/device smoke ; OS sandbox/resource enforcement ; malware scan ; rollback evidence
  mobile artifact+foreground/OS policy proof ; live public download pointer

§R ROLLBACK
  source := revert pipeline commit
  candidate := delete local candidate-dist outputs only
  public := unchanged ; this lane publishes no artifact and no alias

∎
