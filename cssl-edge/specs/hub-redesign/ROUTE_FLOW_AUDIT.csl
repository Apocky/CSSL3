§S NAVIGATION.PROPOSAL
  primary := Tools | Read | Definitions | Community
  utility := Search | Account ; support+help+technical.reference → footer
  Tools := make.sigil + compose.symbolic.phrase + saved.spellbook + ask.Apocrypha + Chaos.reading
  Read := Codex.Apockalypsis + essays + useful.conversation.ideas + cosmology
  Definitions := searchable.words+symbols + examples + related.tool.action
  Community := Clearing.public.read ; sign.in.at.posting.action
  Search := persistent.visible.trigger ; mobile.full.viewport.safe.dialog ; same.public.catalogue.as.nav+Atlas
  home := concise.invitation → visible.tool.actions+Read.Codex → useful.essay/idea → browse.more
  N! task.cards.hidden.inside.closed.details
  card.contract := useful.result + plain.name + input/access.requirement + action
  Codex.labels := “Read Codex Apockalypsis” + “Begin the story” + “Explore the world”
  Codex.search.aliases := Good.Book | Bible | novel | dark.fantasy | Lilith | Eden | Omnoid
  story.first := opening.chapter ; supporting.notes+maps+sources secondary ; spoiler.notice.before.spoilers
  technical.details := optional.details preserving source+history+claims ; N! deletion.to.hide.uncertainty
  related.links := next.useful.action ; replace.“Contextual.synapses” with.“You.might.also.like”
  ↓ same.navigation.catalogue drives.desktop+mobile+search+Atlas+footer+route.sitemap

