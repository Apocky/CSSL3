  /shawn/clinical → private.clinician.dossier ; no.public.directory/search
  /content + /content/feed + /content/search + /content/subscribed + /content/trending + /content/[slug]
    → shared.publication.gated ; no.public.launch.until.backing.service.verified
  /gear-share + /run-share-feed → inactive.game.sharing ; preserve404
  /404 + /500 → useful.error+home/search.recovery ; not.discoverable.destinations
  /commons + /commons/index.html →308→home ; /commons/clearing.html→308→Clearing
  /commons/atlas.html + /commons/membership.html + /commons/principles.html → legacy200duplicates
    ◇ migrate.inbound.links+canonical.redirects.after.content.parity ; N! silently.drop.unique.content
  /apoc + /chat → retired404 ; no.public.link.revival
  /admin/payments + /devblog + /devblog/why-cssl + /press → absent404 ; repair.source.links

§S KEY.JOURNEY.ORACLES
  J1 story := home.visible.Read.Codex→opening ; search.Codex|Good.Book→same ; phone+keyboard
  J2 definition := home.Definitions→search.term→meaning+example→try.related.tool
  J3 sigil := home.Make.a.sigil→input→preview→download ; saved.work.reopens.on.device
  J4 essay := home.Read→essays.default→chosen.essay→next.read ; no.metadata.detour
  J5 idea := home.Read→conversation.ideas→search.theme→plain.useful.paraphrase
  J6 community := home.Community→thread→sign.in.at.write→same.thread ; no.draft.loss
  J7 personal.chat := home.Ask.Apocrypha→sign.in→own.composer ; no.private.history.exposure
  J8 external.reading := home.Tarot→clear.external+sign.in.label→actual.destination ; no.false.free/local.claim
  J9 game := home.Tools|Play→download→right.platform→first.steps
  J10 return := any.reader/tool→Home|Search|sibling.task≤1global.control ; stable.back+focus
  J11 failure := missing.route|empty.search|unavailable.network→named.recovery ; no.blank.panel
  N! root.CUA.report⇒independent.agent.visual.inspection

§S OWNERSHIP.CANDIDATES
