  ✓ /shawn+references := publication.gated ; clinical+brain := private ; N! discovery.promotes.private.data
  ✓ broken.navigation := docs→/devblog + /devblog/why-cssl + /press(404) ; admin→/admin/payments(404)
  ✓ Oracle := /oracle→308.external.Chaos ; registry.labels.public.local mismatches.source.redirect
  ○ root.CUA@390×844 := Chaos→login ; Codex.search0 ; mobile.menu.absent ; search.panel.clipped
  ○ root.CUA := Atlas.firstscreen.no.useful.input ; Words.no.search ; ideas+essays.below.technical.counts
  ◇ priority := useful.tools + searchable.definitions + thoughts/essays + direct.story.access
  N! prominent.GUI := architecture.labels | build.hashes | telemetry | publication.denominators | approval.process
  W! actual.authority+privacy.gates.persist ; technical.details.remain.optional

