  reading.next := start+now+labs+memory.tools+divination+cosmology+docs+support+game.public.pages
  exclusions := auth+account+chat+admin+runtime+private.atlas+legal.text+source.record.bodies
  W! implementation.keep := citations+admission.gates+author.attribution+all.records+URL.stability
  W! each.changed.family → exact.file.coverage + focused.validation + root.rendered.QA

