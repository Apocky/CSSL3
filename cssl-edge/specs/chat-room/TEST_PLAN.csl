§ CUA_ORACLES
  widths := 320 + 390 + 768 + 1440 ; also mobile short viewport + desktop zoom
  each := visible header + readable messages + reachable composer + no horizontal page overflow
  scroll := long history scrolls independently ; composer remains reachable ; table/unbroken token contained
  panels := Create + History + Details/settings + owner Memory
  flow := Create → choose tool → create → close → reopen → same source/result
  keyboard := reachable controls + named textarea + visible focus ; Escape closes/returns trigger
  typing := Shift+Enter newline ; composition Enter no send ; plain Enter explicit send
  creation := draw/make/switch/variant/copy/download N! chat POST
  Add := retains prior draft + separator + result ; closes panel + focuses composer ; N! automatic send
  oracle := chance reflection label ; no confidence misrepresentation ; high-stakes refusal preserved
  owner.cap := insertion ≤16384 UTF16 code units ∧ ≤16384 UTF8 bytes ; exact ASCII boundary accepted ; either limit exceeded → refusal ; emoji counts2 units+4 bytes
  account.cap := 16384 UTF8 bytes ; exact boundary accepted ; boundary+1 refused ; emoji counted4
  cap.refusal := existing draft unchanged + result retained + visible failure ; no truncated surrogate
  pending.account := draft/send/new chat blocked ; create inspect allowed ; Add disabled ; retry same request
  pending.owner := prior queue retained through panel switch/new chat/history ; new explicit send adds one unique turn
  reload := account pending ID preserved ; owner synthetic queue preserved ; N! mocked owner reload proves real vault
  private.queue := compare before/after IDs for every non-send action
  signed-out := actual auth route reviewed separately ; fixture does not prove production authorization

