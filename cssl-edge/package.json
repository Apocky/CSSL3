{
  "name": "apocky-com-organism",
  "version": "1.0.0",
  "private": true,
  "description": "Three-surface Apocky web organism: public sanctuary, private encounter, and protected operations.",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "npm run dev --workspace @apocky/site",
    "dev:encounter": "npm run dev --workspace @apocky/encounter",
    "dev:ops": "npm run dev --workspace @apocky/ops",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:public": "npm run test --workspace @apocky/site",
    "test:security": "npm run test --workspace @apocky/security && npm run test --workspace @apocky/ops && npm run test --workspace @apocky/encounter",
    "test:contracts": "npm run test --workspace @apocky/contracts",
    "test:encounter": "npm run test --workspace @apocky/encounter",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "clean:generated": "node scripts/clean-generated.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "next@16.2.11": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    },
    "postcss": "8.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  }
}
