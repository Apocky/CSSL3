# Discord bridge configuration.
#
# Copy to D:\Apocrypha\discord.env and fill in the two required values.
# That file is OUTSIDE the repo on purpose -- the same convention as work.env and
# apocrypha-runtime.env -- so a token can never be committed by accident.
#
# Check it before starting anything:
#     node --env-file=D:\Apocrypha\discord.env --import tsx scripts/apocrypha-discord/runner.ts --check

# ---- required -------------------------------------------------------------------------------

# Developer portal -> your application -> Bot -> Reset Token -> Copy.
# Treat this like a password: anyone holding it IS the bot. If it is ever pasted into a chat, a
# log, or a commit, reset it in the portal immediately -- resetting is free and instant.
APOCRYPHA_DISCORD_TOKEN=

# Your own Discord user id, as digits. In Discord: Settings -> Advanced -> Developer Mode on,
# then right-click your name -> Copy User ID. This is the account Apocrypha treats as the owner:
# the only one it will DM with and the only one it remembers.
APOCRYPHA_DISCORD_OWNER_ID=

# ---- optional -------------------------------------------------------------------------------

# Printed at startup as a ready-made invite link. Developer portal -> General Information ->
# Application ID. Not a secret.
APOCRYPHA_DISCORD_APPLICATION_ID=

# Channels where EVERY message is treated as addressed to Apocrypha, no mention needed.
# Comma-separated channel ids. Leave empty and it only answers mentions, replies, and your DMs.
# Only put a channel here that everyone in it knows is an Apocrypha channel.
APOCRYPHA_DISCORD_CHANNELS=

# The local mind service: persona plus memory, the same one the website reaches.
# 19132, NOT 19131 -- the mind service's own code default is 19131, but that port is probed
# elsewhere as a "stray second engine" check, so binding it makes the work lane's doctor report a
# phantom engine.
APOCRYPHA_DISCORD_MIND_URL=http://127.0.0.1:19132

# How long to wait for an answer before telling the person it is not coming.
# A cold model load can take a while; 180 s is deliberately generous.
APOCRYPHA_DISCORD_TIMEOUT_MS=180000

# This bridge's own health endpoint. 19133 is free; 19124 and 19131 are spoken for.
APOCRYPHA_DISCORD_PORT=19133
APOCRYPHA_DISCORD_HOST=127.0.0.1

# Where halts and per-channel introductions are remembered across restarts.
APOCRYPHA_DISCORD_STATE_DIR=D:\Apocrypha\discord

# ---- belongs to the MIND service, not this bridge, but it matters here --------------------
#
# The mind service defaults reasoning ON (APOCRYPHA_MIND_REASONING !== '0'), which contradicts the
# standing "thinking off" directive and makes every Discord answer slower and more verbose.
# Set this in the mind service's own environment when you start it:
#
#     APOCRYPHA_MIND_REASONING=0
#     APOCRYPHA_MIND_PORT=19132
