# Store the token in the host secret store or an ignored local environment file.
APOCRYPHA_MEMORY_GATEWAY_HOST=127.0.0.1
APOCRYPHA_MEMORY_GATEWAY_PORT=19127
APOCRYPHA_MEMORY_GATEWAY_TOKEN=
APOCRYPHA_MEMORY_GATEWAY_TIMEOUT_MS=5000
APOCRYPHA_MEMORY_GATEWAY_ALLOWED_TENANTS=00000000-0000-4000-8000-000000000000
APOCRYPHA_MEMORY_GATEWAY_ALLOWED_PRINCIPALS=00000000-0000-4000-8000-000000000000
APOCRYPHA_MEMORY_GATEWAY_ALLOWED_CAPABILITIES=apocky_owner_chat,chaos_tarot_reading

# Native immutable/read-only paths. The gateway never sends refresh, run,
# withdraw, rollback, restore, or any other write-capable operation.
APOCRYPHA_MEMORY_OWNER_ID=apocky
APOCRYPHA_MEMORY_PRIVACY_PARTITION=owner:apocky
APOCRYPHA_MEMORY_FEDERATOR_EXE=C:\absolute\apocrypha-memory-federator.exe
APOCRYPHA_MEMORY_FEDERATOR_CONFIG=C:\absolute\owner-local.apocky.json
APOCRYPHA_MEMPALACE_DB_PATH=C:\absolute\chroma.sqlite3
APOCRYPHA_ANAMNESIS_DB_PATH=C:\absolute\anamnesis.db
APOCRYPHA_BRAINMONSOON_EXE=C:\absolute\brainmonsoon-package\bin\apocrypha-brainmonsoon-organ.exe
APOCRYPHA_BRAINMONSOON_EXE_SHA256=
APOCRYPHA_BRAINMONSOON_REGISTRY_PATH=C:\absolute\brainmonsoon-package\registry\TOOLS.json
APOCRYPHA_BRAINMONSOON_REGISTRY_SHA256=
APOCRYPHA_BRAINMONSOON_CSL_PATH=C:\absolute\brainmonsoon-package\contracts\brainmonsoon_contract.csl
APOCRYPHA_BRAINMONSOON_CSL_SHA256=
APOCRYPHA_BRAINMONSOON_NIL_PATH=C:\absolute\brainmonsoon-package\contracts\brainmonsoon_stages.nil
APOCRYPHA_BRAINMONSOON_NIL_SHA256=
APOCRYPHA_BRAINMONSOON_CSSL_PATH=C:\absolute\brainmonsoon-package\contracts\brainmonsoon_policy.cssl
APOCRYPHA_BRAINMONSOON_CSSL_SHA256=
APOCRYPHA_BRAINMONSOON_STATE_ROOT=C:\absolute\brainmonsoon-state
APOCRYPHA_BRAINMONSOON_LINEAGE_SHA256=
APOCRYPHA_GRAPH_ORGAN_EXE=C:\absolute\apocrypha-graph-organ.exe
APOCRYPHA_GRAPH_PATH=C:\absolute\graph.json
APOCRYPHA_GRAPH_CSL_PATH=C:\absolute\graph_query_contract.csl
APOCRYPHA_GRAPH_NIL_PATH=C:\absolute\graph_stage_graph.nil
APOCRYPHA_GRAPH_CSSL_PATH=C:\absolute\graph_policy.cssl

# A faculty can instead use an already-running loopback read-only HTTP service.
# Configure its exact search URL and optional health URL/token. Non-loopback
# URLs are rejected during startup.
APOCRYPHA_ANAMNESIS_READ_UPSTREAM_URL=
APOCRYPHA_ANAMNESIS_READ_HEALTH_URL=
APOCRYPHA_ANAMNESIS_READ_UPSTREAM_TOKEN=
APOCRYPHA_BRAINMONSOON_READ_UPSTREAM_URL=
APOCRYPHA_BRAINMONSOON_READ_HEALTH_URL=
APOCRYPHA_BRAINMONSOON_READ_UPSTREAM_TOKEN=
