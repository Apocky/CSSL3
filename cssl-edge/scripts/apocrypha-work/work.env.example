# Apocrypha Work lane -- local coding agent.
# Copy to C:\Apocrypha\work\work.env and edit. Loaded by node --env-file.
#
# ASCII-canonical per VERIFICATION_KERNEL %%1. This file holds NO secret: the service token is
# minted on first run into <STATE_DIR>\work.token (0600) and read from there by both the service
# and the Next.js proxy. Do not paste a token here unless you are deliberately pinning one.

# -- where the agent may work ------------------------------------------------
# Format: label=path[:ro] entries separated by ";". Append :ro to make a root read-only.
# The FIRST root is the default for relative paths. Nothing outside these roots exists for the
# agent: paths are canonicalised (symlinks AND junctions followed) and checked on every call.
APOCRYPHA_WORK_ROOTS=repos=C:\Users\Apocky\source\repos;apocrypha-runtime=D:\Apocrypha\workspace

# -- engine ------------------------------------------------------------------
# Started by apocrypha-core\tools\run-work-engine.ps1 on 19131. Chat lives on 19128.
# Only ONE of them can hold the GPU on this host -- see the arbiter block below.
APOCRYPHA_WORK_ENGINE_URL=http://127.0.0.1:19131
APOCRYPHA_WORK_MODEL_ALIAS=qwen3-coder-next-80b-a3b-q2kxl
# The model trains at 262144; 32768 is what one slot's KV costs here at q8_0.
APOCRYPHA_WORK_CONTEXT=32768
APOCRYPHA_WORK_MAX_OUTPUT=4096
# Qwen's published sampling for this model.
APOCRYPHA_WORK_TEMPERATURE=0.7
APOCRYPHA_WORK_TOP_P=0.8
APOCRYPHA_WORK_TOP_K=20

# -- GPU arbiter -------------------------------------------------------------
# MEASURED 2026-09-14 (E:obs): Chat engine alone leaves 19.4 GB RAM free. Chat + a second engine
# leaves 1.1 GB and the second engine dies out-of-memory mid-generation. Windows caps the WDDM
# shared pool at half of system RAM (15.9 GB) and Chat already sits AT that cap. The lanes
# therefore take turns on the card; this is segregation by time, not by partition.
#
#   off    - never touch either engine; you start and stop them by hand.
#   manual - handover only when the Work tab asks for it (POST /engine/acquire).
#   auto   - DEFAULT. A Work turn takes the GPU by itself, but ONLY once the Chat worker reports
#            idle and any in-flight Chat job has drained. Card returns to Chat on idle timeout.
APOCRYPHA_WORK_ARBITER=auto
APOCRYPHA_WORK_CHAT_PORT=19128
APOCRYPHA_WORK_CHAT_WORKER_HEALTH=http://127.0.0.1:19126/health
APOCRYPHA_WORK_CHAT_LAUNCHER=C:\Users\Apocky\source\repos\apocrypha-core\tools\run-qwen35-vulkan.ps1
APOCRYPHA_WORK_ENGINE_LAUNCHER=C:\Users\Apocky\source\repos\apocrypha-core\tools\run-work-engine.ps1
APOCRYPHA_WORK_ENGINE_PROFILE=exclusive
# How long to wait for an in-flight Chat job before REFUSING the handover. Never auto-approves.
APOCRYPHA_WORK_DRAIN_TIMEOUT_MS=120000
# Model load budget. 24.92 GiB off C: (NVMe, 3426 MB/s measured) is ~7 s of I/O plus warmup;
# the generous ceiling is for a cold page cache and the -fit pass.
APOCRYPHA_WORK_START_TIMEOUT_MS=420000
# Give the card back to Chat after this much Work idleness. 0 disables the yield.
# Chat is the PUBLIC lane; leaving it down because a browser tab closed is an outage, not a
# convenience, so this should stay well under an hour.
APOCRYPHA_WORK_IDLE_YIELD_MS=900000

# -- service -----------------------------------------------------------------
APOCRYPHA_WORK_HOST=127.0.0.1
APOCRYPHA_WORK_PORT=19130
# On C: with the model: session transcripts and the append-only event log are write-heavy.
APOCRYPHA_WORK_STATE_DIR=C:\Apocrypha\work

# -- policy ------------------------------------------------------------------
# Risk tiers that run WITHOUT asking. "read" is the default and the recommended setting.
# Adding "write" lets the agent edit files unprompted; adding "execute" lets it run commands
# unprompted. A standing deny-list still blocks catastrophic commands at either setting, and
# workspace confinement is never waived by any value here.
APOCRYPHA_WORK_AUTO_APPROVE=read

# Set to "off" to remove run_command from the tool set entirely.
APOCRYPHA_WORK_SHELL=on

# Tool steps per task, then the agent stops and reports rather than looping.
APOCRYPHA_WORK_MAX_ITERATIONS=40
APOCRYPHA_WORK_TOOL_TIMEOUT_MS=120000
APOCRYPHA_WORK_TURN_TIMEOUT_MS=1800000
