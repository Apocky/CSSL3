# Secrets belong in the host secret store or ignored .env.local, never in Git.
APOCRYPHA_CONTROL_PLANE_URL=https://www.apocky.com
# UUID returned by the control plane's issue_worker_token operation.
APOCRYPHA_WORKER_NODE_ID=00000000-0000-4000-8000-000000000000
# Resident-host credential returned once by the same operation. Do not copy it to Vercel.
APOCRYPHA_WORKER_TOKEN=

# Exact currently accepted Qwen profile.
APOCRYPHA_QWEN_BASE_URL=http://127.0.0.1:19124/v1
APOCRYPHA_QWEN_RUNTIME_PROFILE_PATH=D:\Apocrypha\models\Qwen3.5-35B-A3B-Q4\runtime-profile.json
APOCRYPHA_MODEL_ALIAS=qwen35-35b-a3b-q4
APOCRYPHA_MODEL_PROFILE_HASH=5d390055297aed74dbba092eb313dc8c4bf4e551ca4bf2c50fed16c8cb3a21a9
APOCRYPHA_QWEN_CONTEXT_TOKENS=4096
APOCRYPHA_QWEN_MAX_OUTPUT_TOKENS=2048
APOCRYPHA_QWEN_IDLE_TIMEOUT_MS=180000
APOCRYPHA_QWEN_MAX_RUNTIME_MS=2700000

# Durable delivery and loopback diagnostics.
APOCRYPHA_WORKER_JOURNAL_DIR=D:\Apocrypha\worker-journal
APOCRYPHA_WORKER_HEALTH_HOST=127.0.0.1
APOCRYPHA_WORKER_HEALTH_PORT=19126

# Configure each admitted read-only faculty independently. Missing faculties are
# reported as partial availability and never stall Qwen.
APOCRYPHA_MEMPALACE_READ_URL=
APOCRYPHA_MEMPALACE_READ_TOKEN=
APOCRYPHA_BRAINMONSOON_READ_URL=
APOCRYPHA_BRAINMONSOON_READ_TOKEN=
APOCRYPHA_ANAMNESIS_READ_URL=
APOCRYPHA_ANAMNESIS_READ_TOKEN=
APOCRYPHA_GRAPHIFY_READ_URL=
APOCRYPHA_GRAPHIFY_READ_TOKEN=
APOCRYPHA_MNEME_READ_URL=
APOCRYPHA_MNEME_READ_TOKEN=
