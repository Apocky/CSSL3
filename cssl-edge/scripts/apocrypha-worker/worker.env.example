# Secrets belong in the host secret store or ignored .env.local, never in Git.
APOCRYPHA_CONTROL_PLANE_URL=https://www.apocky.com
# UUID returned by the control plane's issue_worker_token operation.
APOCRYPHA_WORKER_NODE_ID=00000000-0000-4000-8000-000000000000
# Resident-host credential returned once by the same operation. Do not copy it to Vercel.
APOCRYPHA_WORKER_TOKEN=

# Exact currently accepted Qwen profile.
APOCRYPHA_QWEN_BASE_URL=http://127.0.0.1:19124/v1
APOCRYPHA_QWEN_RUNTIME_PROFILE_PATH=D:\Apocrypha\models\Qwen3.5-35B-A3B-Q4\runtime-profile.json
APOCRYPHA_MODEL_ALIAS=qwen35-35b-a3b-q4
APOCRYPHA_MODEL_PROFILE_HASH=5d390055297aed74dbba092eb313dc8c4bf4e551ca4bf2c50fed16c8cb3a21a9
APOCRYPHA_QWEN_CONTEXT_TOKENS=4096
APOCRYPHA_QWEN_MAX_OUTPUT_TOKENS=2048
APOCRYPHA_QWEN_IDLE_TIMEOUT_MS=180000
APOCRYPHA_QWEN_MAX_RUNTIME_MS=2700000

# Optional premium frontier rail. Both values are required before a provider
# call can occur; a matching provider key is read from the host environment.
# Premium jobs fall back to Qwen when this rail is absent or unavailable.
APOCRYPHA_FRONTIER_PROVIDER=
APOCRYPHA_FRONTIER_MODEL=
APOCRYPHA_FRONTIER_BASE_URL=
APOCRYPHA_FRONTIER_TIMEOUT_MS=90000
APOCRYPHA_FRONTIER_COOLDOWN_MS=300000

# Durable delivery and loopback diagnostics.
APOCRYPHA_WORKER_JOURNAL_DIR=D:\Apocrypha\worker-journal
APOCRYPHA_WORKER_HEALTH_HOST=127.0.0.1
APOCRYPHA_WORKER_HEALTH_PORT=19126

# Scope used for periodic, real, read-only adapter probes. The principal defaults
# to the worker UUID, which is admitted only through the Chaos member capability.
APOCRYPHA_MEMORY_PROBE_TENANT_ID=00000000-0000-4000-8000-000000000000
APOCRYPHA_MEMORY_PROBE_CAPABILITY=chaos_tarot_reading
# Additional exact scopes are probed before the resident advertises memory as
# healthy. Format: tenant_id:principal_id:capability, with comma-separated entries.
# Use the resident node UUID as the member canary principal and the actual active
# tenant UUID whose database slug is apocky-members.
APOCRYPHA_MEMORY_ADDITIONAL_PROBE_SCOPES=00000000-0000-4000-8000-000000000001:00000000-0000-4000-8000-000000000002:apocky_owner_chat,00000000-0000-4000-8000-000000000003:00000000-0000-4000-8000-000000000000:apocky_member_chat

# Configure each admitted read-only faculty independently. Missing faculties are
# reported as partial availability and never stall Qwen.
# Three concurrent reads keep task-shaped recall bounded while leaving headroom
# for Qwen. Re-benchmark before raising this on a different host.
APOCRYPHA_MEMORY_READ_CONCURRENCY=3
APOCRYPHA_MEMPALACE_READ_URL=
APOCRYPHA_MEMPALACE_READ_TOKEN=
APOCRYPHA_MEMPALACE_READ_TIMEOUT_MS=35000
APOCRYPHA_BRAINMONSOON_READ_URL=
APOCRYPHA_BRAINMONSOON_READ_TOKEN=
APOCRYPHA_BRAINMONSOON_READ_TIMEOUT_MS=45000
APOCRYPHA_ANAMNESIS_READ_URL=
APOCRYPHA_ANAMNESIS_READ_TOKEN=
APOCRYPHA_ANAMNESIS_READ_TIMEOUT_MS=20000
APOCRYPHA_GRAPHIFY_READ_URL=
APOCRYPHA_GRAPHIFY_READ_TOKEN=
APOCRYPHA_GRAPHIFY_READ_TIMEOUT_MS=20000
APOCRYPHA_MNEME_READ_URL=
APOCRYPHA_MNEME_READ_TOKEN=
APOCRYPHA_MNEME_READ_TIMEOUT_MS=20000
APOCRYPHA_METAHARNESS_READ_URL=
APOCRYPHA_METAHARNESS_READ_TOKEN=
APOCRYPHA_METAHARNESS_READ_TIMEOUT_MS=25000
