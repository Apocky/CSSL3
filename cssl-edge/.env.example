# cssl-edge — environment variables (ALL OPTIONAL, stub-friendly)
# Copy to .env.local for local dev (or set in Vercel project settings for deploy).
# When unset, endpoints return well-shaped stub responses with `stub:true`.

# === Claude / Anthropic LLM (drives /api/intent text→scene-graph) ===
# Get from https://console.anthropic.com/
CLAUDE_API_KEY=

# === Lazarus autonomous LoA v14 runner ===
# DeepSeek key stays server/local-runner only; never expose via NEXT_PUBLIC_*.
DEEPSEEK_API_KEY=
# Runner calls DeepSeek only when explicitly enabled.
LAZARUS_ENABLE_MODEL_CALLS=0
LAZARUS_CONTROL_URL=http://localhost:3000
LAZARUS_RUNNER_ID=local-apocky
LAZARUS_RUNNER_LABEL=LoA v14 local Lazarus runner
LAZARUS_RUNNER_TOKEN=
# Set to 1 for one-shot smoke tests; keep 0/unset for the service runner loop.
LAZARUS_ONCE=0

# === Admin Chat (/admin/chat) ===
# The admin chat route does not fabricate responses. It calls DeepSeek when
# DEEPSEEK_API_KEY is set, otherwise Anthropic when ANTHROPIC_API_KEY or
# CLAUDE_API_KEY is set. Optional model override:
ADMIN_CHAT_MODEL=
ADMIN_CHAT_DEEPSEEK_MODEL=deepseek-reasoner
ADMIN_CHAT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# === Supabase (cache + auth · drives /api/asset/* + /api/generate/* persistence) ===
# Get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Direct SMS to Apocrypha (server-only; disabled unless every value is valid) ===
# The v1 channel binds exactly one owner number to one dedicated SMS session.
# Do not use NEXT_PUBLIC_* names. Applying migration 0046 and configuring the
# provider webhook/number are separate activation steps.
TWILIO_ACCOUNT_SID=
# Primary Auth Token is used only to validate provider-signed webhooks.
TWILIO_AUTH_TOKEN=
# Restricted API key credentials are used for outbound message creation.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
APOCRYPHA_SMS_WEBHOOK_URL=https://www.apocky.com/api/apocrypha/sms/inbound
APOCRYPHA_SMS_STATUS_CALLBACK_URL=https://www.apocky.com/api/apocrypha/sms/status
APOCRYPHA_SMS_NUMBER_E164=
APOCRYPHA_SMS_OWNER_E164=
APOCRYPHA_SMS_OWNER_USER_ID=
# Dedicated UUIDv4; never reuse the browser's active conversation UUID.
APOCRYPHA_SMS_SESSION_ID=
# Independent 32-byte Base64 keys for phone-binding HMAC and encrypted envelopes.
APOCRYPHA_SMS_BINDING_KEY_BASE64=
APOCRYPHA_SMS_STORAGE_KEY_ID=
APOCRYPHA_SMS_STORAGE_KEY_BASE64=
# During rotation, retain at most the immediately previous queue key until drained.
APOCRYPHA_SMS_PREVIOUS_STORAGE_KEY_ID=
APOCRYPHA_SMS_PREVIOUS_STORAGE_KEY_BASE64=
APOCRYPHA_SMS_MAX_REPLY_CHARS=320
APOCRYPHA_SMS_MAX_SEGMENTS=3
APOCRYPHA_SMS_DAILY_SEGMENT_BUDGET=30

# NEXT_PUBLIC_ variants are required for CLIENT-SIDE auth (OAuth, magic-link, /account page).
# Without these the auth buttons show stub-mode and sign-in is unavailable in the browser.
# Set them to the same values as SUPABASE_URL / SUPABASE_ANON_KEY above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Owner-private Apocrypha runtime relay (server-only; disabled by default) ===
# Enabling the UI does not create ingress. The hostname/tunnel, Cloudflare Access
# policy, local credential ACLs, and an owner-bound G12 runtime must be verified
# independently before setting this to 1 in a deployment.
APOCKY_BRAIN_LOCAL_PROVIDER_ENABLED=0
APOCV4_API_TOKEN=
# Free secure ingress option: fixed Cloudflare Access hostname only.
APOCV4_RUNTIME_TRANSPORT=cloudflare-access
APOCV4_RUNTIME_URL=https://apocrypha.apocky.com
APOCRYPHA_TUNNEL_HOST=apocrypha.apocky.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Alternative pinned direct-TLS transport (do not combine with cloudflare-access).
APOCV4_RUNTIME_DIRECT_IP=
APOCV4_RUNTIME_DIRECT_PORT=
APOCV4_RUNTIME_CA_B64=

# === Shawn private clinical appendix (server-only; never NEXT_PUBLIC_*) ===
# Private Storage object is read only after Supabase user verification and the
# immutable auth.users UUID allowlist check. SHA-256 pins the approved dossier.
SHAWN_CLINICAL_BUCKET=shawn-clinical
SHAWN_CLINICAL_OBJECT=
SHAWN_CLINICAL_SHA256=

# === Shawn public atlas production ratification gate (server-only) ===
# Candidate builds are visible in development only. Production /shawn routes
# require the exact ratified ContextFrame bytes plus their lowercase SHA-256.
SHAWN_ATLAS_RATIFIED_FRAME_BASE64=
SHAWN_ATLAS_RATIFIED_FRAME_SHA256=

# === Free-asset upstream APIs (license-filtered proxy targets) ===
# Sketchfab Data API — https://sketchfab.com/developers/data-api/v3
SKETCHFAB_API_TOKEN=
# Polyhaven (CC0) — no key required, but rate-limit aware
POLYHAVEN_USER_AGENT=cssl-edge/0.1
# OpenGameArt — public scrape, no key
# Quaternius / Kenney — public CDNs, no key

# === Neural-3D providers (drives /api/generate/3d gateway) ===
# Stability AI — https://platform.stability.ai/
STABILITY_API_KEY=
# Meshy — https://www.meshy.ai/api
MESHY_API_KEY=
# Tripo — https://www.tripo3d.ai/
TRIPO_API_KEY=

# === Edge runtime config ===
# Override served_by tag (default "cssl-edge")
EDGE_SERVED_BY=cssl-edge
# Default cap when client omits it ("sovereign" | "none")
EDGE_DEFAULT_CAP=sovereign

# === MNEME memory service (specs/43..45) ===
# Anthropic API — Haiku 4.5 (extract/verify/classify/query) + Sonnet 4.6 (synth)
ANTHROPIC_API_KEY=
# Voyage AI — voyage-3-large 1024d embeddings
VOYAGE_API_KEY=
# Owner Ed25519 PK (64 hex chars) used to bind sovereign profile rows
MNEME_SOVEREIGN_PUBKEY_HEX=
# Per-profile default sigma mask (32 bytes hex = 64 chars). Optional; if set
# overrides the constructed `defaultMask()` in lib/mneme/sigma.ts.
MNEME_DEFAULT_MASK_HEX=
# Voyage timeout in ms (default 10000). Bump in slow-network environments.
MNEME_VOYAGE_TIMEOUT=10000
# Per-route recall cache TTL seconds (default 5; 0 disables).
MNEME_RECALL_CACHE_TTL_SECONDS=5
