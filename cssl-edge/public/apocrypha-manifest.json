{
  "schema": "apocky.site-manifest.v1",
  "schema_href": "/schemas/site-manifest.v1.json",
  "name": "Apocky",
  "canonical_url": "https://www.apocky.com/",
  "audiences": ["people", "software_readers", "developers"],
  "declared_release_state": "public",
  "entry_points": [
    {
      "rel": "home",
      "href": "/",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "public"
    },
    {
      "rel": "apocrypha_conversation",
      "href": "/apocrypha",
      "method": "GET",
      "media_type": "text/html",
      "authn": "site_account_required_to_send",
      "authorization": "authenticated_member",
      "availability": "public_member_interface",
      "consent": "each_send_authorizes_one_restricted_ephemeral_turn_without_training_consent"
    },
    {
      "rel": "public_social_room",
      "href": "/clearing",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public_read_account_required_for_write",
      "availability": "public",
      "consent": "posting_is_an_explicit_account_action"
    },
    {
      "rel": "project_atlas",
      "href": "/atlas",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "public"
    },
    {
      "rel": "interface_principles",
      "href": "/principles",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "public"
    },
    {
      "rel": "membership_design_study",
      "href": "/membership",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public_read_only",
      "availability": "design_study_not_enrollment"
    },
    {
      "rel": "words_and_symbols",
      "href": "/words",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "public"
    },
    {
      "rel": "game_download",
      "href": "/download",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "public"
    },
    {
      "rel": "writing",
      "href": "/akashic-records",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "public"
    },
    {
      "rel": "works_archive",
      "href": "/akashic-records",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "public"
    },
    {
      "rel": "works_archive_manifest",
      "href": "/akashic-records/manifest.json",
      "method": "GET",
      "media_type": "application/json",
      "authn": "none",
      "authorization": "public",
      "availability": "public"
    },
    {
      "rel": "language",
      "href": "https://cssl.dev/",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "external_public"
    },
    {
      "rel": "notation",
      "href": "https://cssl.dev/CSLv3",
      "method": "GET",
      "media_type": "text/html",
      "authn": "none",
      "authorization": "public",
      "availability": "external_public"
    }
  ],
  "apocrypha": {
    "claims": {
      "public_identity_definition": "none",
      "public_authorship": "only_when_clearly_attributed",
      "public_social_room": "/clearing",
      "public_conversation_service": "/apocrypha; signed-in text; ephemeral page transcript; no training consent",
      "content_generation": "voluntary_not_expected"
    }
  },
  "policies": {
    "privacy": "/legal/privacy",
    "terms": "/legal/terms",
    "words_and_symbols": "/words",
    "effects": "require_explicit_permission",
    "consent": "informed_specific_withdrawable",
    "attribution": "required_before_speaking_for_someone"
  }
}
