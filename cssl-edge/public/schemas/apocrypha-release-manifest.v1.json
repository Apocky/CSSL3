{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.apocky.com/schemas/apocrypha-release-manifest.v1.json",
  "title": "Apocrypha public-safe release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_href",
    "manifest_version",
    "version",
    "release_state",
    "generated_at",
    "release_label",
    "project",
    "track",
    "public_safe",
    "source_revision",
    "build",
    "documents",
    "download_status",
    "download",
    "claim_boundary",
    "content_digest"
  ],
  "properties": {
    "schema": {"const": "apocky.apocrypha-release-manifest.v1"},
    "schema_href": {"const": "/schemas/apocrypha-release-manifest.v1.json"},
    "manifest_version": {"const": 1},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "release_state": {"enum": ["CANDIDATE", "RELEASED", "RETIRED"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "release_label": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"const": "Apocrypha"},
    "track": {"const": "local-living"},
    "public_safe": {"const": true},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "verification", "release_gate", "missing"],
      "properties": {
        "state": {"type": "string", "minLength": 1, "maxLength": 128},
        "verification": {"type": "string", "minLength": 1, "maxLength": 256},
        "release_gate": {"enum": ["CLOSED", "OPEN"]},
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "changelog", "manifest"],
      "properties": {
        "plan": {"$ref": "#/$defs/documentBinding"},
        "changelog": {"$ref": "#/$defs/documentBinding"},
        "manifest": {"$ref": "#/$defs/documentLink"}
      }
    },
    "download_status": {
      "enum": [
        "NO_PROMOTED_ARTIFACT",
        "DECLARED_ARTIFACT_ABSENT",
        "ARTIFACT_HELD_NOT_RELEASED",
        "RELEASED_ARTIFACT_PRESENT"
      ]
    },
    "download": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/download"}
      ]
    },
    "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 1024},
    "content_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"download": {"type": "object"}},
        "required": ["download"]
      },
      "then": {
        "properties": {
          "release_state": {"const": "RELEASED"},
          "download_status": {"const": "RELEASED_ARTIFACT_PRESENT"},
          "build": {
            "type": "object",
            "properties": {"release_gate": {"const": "OPEN"}},
            "required": ["release_gate"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"release_state": {"const": "CANDIDATE"}},
        "required": ["release_state"]
      },
      "then": {
        "properties": {
          "download": {"type": "null"},
          "build": {
            "type": "object",
            "properties": {"missing": {"type": "array", "minItems": 1}},
            "required": ["missing"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publicHref": {
      "type": "string",
      "pattern": "^/(?:releases|downloads|schemas)/[A-Za-z0-9._/-]+$",
      "maxLength": 512
    },
    "documentLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "href": {"$ref": "#/$defs/publicHref"}
      }
    },
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href", "sha256", "bytes"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "href": {"$ref": "#/$defs/publicHref"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "href",
        "media_type",
        "platform",
        "bytes",
        "sha256",
        "sha256_href",
        "signature"
      ],
      "properties": {
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
        "href": {"$ref": "#/$defs/publicHref"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "platform": {"type": "string", "minLength": 1, "maxLength": 128},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sha256_href": {"$ref": "#/$defs/publicHref"},
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href", "sha256", "verifier", "key_fingerprint", "receipt_href"],
          "properties": {
            "href": {"$ref": "#/$defs/publicHref"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "verifier": {"type": "string", "minLength": 1, "maxLength": 128},
            "key_fingerprint": {"type": "string", "minLength": 1, "maxLength": 256},
            "receipt_href": {"$ref": "#/$defs/publicHref"}
          }
        }
      }
    }
  }
}
