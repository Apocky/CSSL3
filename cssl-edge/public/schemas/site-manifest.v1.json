{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.apocky.com/schemas/site-manifest.v1.json",
  "title": "Apocky public site manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_href", "name", "canonical_url", "audiences", "declared_release_state", "entry_points", "apocrypha", "policies"],
  "properties": {
    "schema": { "const": "apocky.site-manifest.v1" },
    "schema_href": { "const": "/schemas/site-manifest.v1.json" },
    "name": { "type": "string", "minLength": 1 },
    "canonical_url": { "type": "string", "format": "uri" },
    "audiences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "declared_release_state": { "enum": ["private_beta", "public_beta", "public"] },
    "entry_points": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "apocrypha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims"],
      "properties": {
        "claims": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "policies": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rel", "href", "method", "media_type", "authn", "authorization", "availability"],
      "properties": {
        "rel": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "media_type": { "type": "string", "minLength": 1 },
        "authn": { "type": "string", "minLength": 1 },
        "authorization": { "type": "string", "minLength": 1 },
        "availability": { "type": "string", "minLength": 1 },
        "consent": { "type": "string", "minLength": 1 }
      }
    }
  }
}
